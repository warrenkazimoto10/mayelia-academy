APP_NAME="Mayelia Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://academy.mayeliamobilite.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL — créer la base avant migrate :
#   CREATE DATABASE `mayelia-academy` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mayelia-academy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# En production : MAIL_MAILER=smtp (+ MAIL_HOST, etc.). Les messages du formulaire contact sont aussi envoyés à l’email défini dans Réglages site (table site_configs).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Compte admin (DatabaseSeeder + /admin/login)
ADMIN_EMAIL=admin@mayelia.ci
ADMIN_PASSWORD=changeme

# Avant seed : à la racine du dépôt, générer src/data/mayelia-formations.json
#   npm run seed:dump-formations

# Origines autorisées pour le front (séparées par des virgules)
CORS_ALLOWED_ORIGINS=https://academy.mayeliamobilite.com
